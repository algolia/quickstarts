# Algolia credentials, from the Algolia dashboard under Settings > API keys.
#
# On Vercel you do not need to set these: the Algolia integration injects
# ALGOLIA_APP_ID and ALGOLIA_SEARCH_API_KEY, and vite.config.ts maps them onto the
# VITE_ names below. Locally, run `vercel env pull` or fill this in by hand.

# Your Algolia application ID.
VITE_ALGOLIA_APPLICATION_ID=

# Search key used by the browser. VITE_-prefixed variables are inlined into the client
# bundle and are publicly visible, so never put an admin key here. See "How it works" in
# the README before using this against real data.
VITE_ALGOLIA_SEARCH_API_KEY=

# Optional. The connector's destination index. Defaults to `quickstart-products`, so
# leave it blank unless you named your index something else.
VITE_ALGOLIA_INDEX_NAME=

# Only needed to run `npm run configure:index`.
# This key has write access to your Algolia app. Never expose it in client code, and
# never commit it.
ALGOLIA_WRITE_API_KEY=
